<Project>
  <PropertyGroup>
    <Version>2.4.1</Version>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <!-- BL0016 wants every JS interop call inside a try/catch. The calls it flags are pass-through
         wrappers whose callers decide what a failure means (JsModule), module import and init, and
         the bundled host's startup config read: a catch at any of them could only swallow a
         failure that should surface. Disconnects are caught where they are expected
         (JsModule.DisposeAsync). -->
    <NoWarn>$(NoWarn);CS1591;BL0016</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <PackageLicenseFile>OsmfEula.txt</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <SixLaborsLicenseKey>Id=ctm_01krfkytx8bzkq3gsjc92kfmyq;Kind=Community;ExpiryDateUtc=2027-11-25T09:21:15.9115672Z;Key=EnnWb0h1t+2wdIykrPeKDQ38pqBo54wzHRtR5kVh4ULvrWgG0hTKaRo7ltVWPaY3msBMQHAXXUJJKESqEOz1/g==</SixLaborsLicenseKey>
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-08</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\OsmfEula.txt" Pack="true" PackagePath="" Visible="false" />
    <Using Include="System.ReadOnlySpan&lt;System.Char&gt;" Alias="CharSpan" />
  </ItemGroup>
</Project>
