@page "/"
@inject FileDownloadService FileDownloadService
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation

<PageTitle>Naiad — Mermaid Diagram Renderer</PageTitle>

<div class="editor-layout">
    <section class="editor-pane">
        <div class="pane-header">
            <span class="pane-title">Mermaid</span>
            @if (docsLink is not null)
            {
                <a class="doc-link" href="@docsLink.Url" target="_blank" rel="noopener"
                   title="@($"Open the Mermaid {docsLink.Name} syntax reference")">@docsLink.Name docs ↗</a>
            }
            <span class="pane-spacer"></span>
            <SamplePicker Samples="DiagramSamples.All" OnSampleSelected="LoadSample" />
        </div>
        <textarea class="code-editor"
                  spellcheck="false"
                  autocomplete="off"
                  autocapitalize="off"
                  autocorrect="off"
                  aria-label="Mermaid diagram source"
                  value="@source"
                  @oninput="OnInput"></textarea>
    </section>

    <section class="preview-pane">
        <div class="pane-header">
            <span class="pane-title">Preview</span>
            <span class="pane-spacer"></span>
            <div class="toolbar">
                <button class="toolbar-btn" @onclick="DownloadSvg" disabled="@(!result.HasSvg)" title="Download SVG">SVG</button>
                <button class="toolbar-btn" @onclick="DownloadPng" disabled="@(!result.HasSvg || isExporting)" title="Download PNG">PNG</button>
            </div>
        </div>
        <div class="preview-surface">
            @if (result.HasError)
            {
                <ErrorPanel Message="@(result.Error!)" IssueUrl="@issueUrl" />
            }
            else if (result.HasSvg)
            {
                <div class="preview-content">@((MarkupString) result.Svg!)</div>
            }
            else
            {
                <p class="preview-empty">Type Mermaid markup on the left, or load a sample, to see it rendered here.</p>
            }
        </div>
        @if (stats is { } current)
        {
            <div class="status-bar">
                @if (current.TypeName is { } typeName)
                {
                    <span class="status-item" title="Diagram type">
                        <span class="status-metric">@typeName</span>
                    </span>
                }
                @if (current.Dimensions is { } dimensions)
                {
                    <span class="status-item" title="Diagram size in pixels">
                        <span class="status-metric status-volatile">@FormatDimensions(dimensions)</span>
                    </span>
                }
                <span class="status-item" title="Serialized SVG size">
                    <span class="status-metric status-volatile">@FormatBytes(current.SvgByteCount)</span>
                </span>
                <span class="status-item" title="Time Naiad took to render the diagram">
                    Rendered in <span class="status-metric status-volatile">@FormatMilliseconds(current.Milliseconds)</span>
                </span>
            </div>
        }
    </section>
</div>
